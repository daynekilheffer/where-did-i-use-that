{
  "name": "where-did-i-use-that",
  "version": "1.0.0",
  "description": "find usages of a module inside of a set of repositories",
  "main": "index.js",
  "author": "dayne m kilheffer",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "search": "ts-node index.ts",
    "audit:create": "ts-node generate-audit.ts",
    "audit:search": "ts-node search-audit.ts"
  },
  "dependencies": {
    "@babel/core": "^7.21.8",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.21.5",
    "debug": "^4.3.4",
    "progress": "^2.0.3",
    "table": "^6.8.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "@types/debug": "^4.1.7",
    "@types/progress": "^2.0.5",
    "@types/yargs": "^17",
    "eslint": "^8.40.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended"
    ],
    "env": {
      "node": true,
      "es6": true
    },
    "rules": {
      "no-unused-vars": [
        "error",
        {
          "ignoreRestSiblings": true
        }
      ],
      "no-console": "warn"
    }
  }
}